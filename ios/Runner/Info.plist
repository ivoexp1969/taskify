	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Taskify</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Ориентации -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Производителност -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Launch screen -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Permissions — задължителни за App Store Review -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Taskify uses the microphone to let you add tasks by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Taskify uses speech recognition to convert your voice to task titles.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Taskify can sync your tasks with Google Calendar.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Taskify can add your tasks to Google Calendar.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Taskify needs access to your photo library to import files.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Taskify needs permission to save exported files to your photo library.</string>

	<!-- URL schemes за Google Sign-In — ще се попълни с реалния REVERSED_CLIENT_ID от GoogleService-Info.plist -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Замени com.googleusercontent.apps.XXXXXXX с реалния REVERSED_CLIENT_ID от GoogleService-Info.plist -->
				<string>com.googleusercontent.apps.929046134968-REPLACE_WITH_REAL_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
	</array>

	<!-- Background modes за нотификации -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- Google Mobile Ads — замени с реалния iOS App ID от AdMob конзолата -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>

	<!-- ATT — App Tracking Transparency (изисква се от iOS 14+ за персонализирани реклами) -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Taskify uses advertising identifiers to show you relevant ads and measure their effectiveness.</string>

