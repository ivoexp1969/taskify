rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Taskify Firestore Security Rules (продукция — проект taskify-1969)
//
// СЛОЕВЕ:
//   1) Лични задачи — users/{uid}/...  (само собственикът)
//   2) Промо кодове — promo_codes/...  (четене за всички, update за логнати)
//   3) Споделени групи — groups/... + invites/... (нов слой)
//
// Кодът за присъединяване (inviteCode) е споделената ТАЙНА. invites/{code}
// мапва само код→groupId (нечувствително): GET по точен код, LIST забранен.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Потребителски данни - само собственикът има достъп
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Подколекции на потребителя (tasks, categories)
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Промо кодове - четене за всички, update за логнати
    match /promo_codes/{code} {
      allow read: if true;
      allow update: if request.auth != null;
    }

    // ─────────── ОФЕРТИ ЗА ПОДНОВЯВАНЕ (Идея 1 — монетизация) ──────────
    // renewal_offers/{id} → { doctype, partner, urlTemplate, commercial,
    // countries[], enabled, labelKey }. Четене за ВСИЧКИ (клиентът резолвира
    // оферта по doctype+държава). Писане само от конзола/админ (remote config).
    match /renewal_offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }

    // renewal_clicks/{id} — append-only лог за атрибуция/CTR. Клиентът само
    // СЪЗДАВА (никакъв read/update/delete). Изисква логнат потребител, за да не
    // се спами (анонимните кликове падат тихо в try/catch → само локален брояч).
    match /renewal_clicks/{clickId} {
      allow create: if signedIn()
                    && request.resource.data.doctype is string
                    && request.resource.data.subid is string;
      allow read, update, delete: if false;
    }

    // ─────────────────────────── ПОКАНИ ───────────────────────────────
    // invites/{inviteCode} → { groupId }. GET по точен код за всеки логнат
    // (резолвва groupId). LIST забранен (без enumerate на кодове).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.groupId is string;
      allow update: if false;
      allow delete: if signedIn();
    }

    // ─────────────────────────── ГРУПИ ────────────────────────────────
    match /groups/{groupId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }
      function membersWithinLimit() {
        return request.resource.data.members.size() <= 20;
      }
      function addsOnlySelf() {
        let added = request.resource.data.members.toSet()
                      .difference(resource.data.members.toSet());
        let removed = resource.data.members.toSet()
                      .difference(request.resource.data.members.toSet());
        return added.hasOnly([request.auth.uid])
            && added.size() == 1
            && removed.size() == 0
            && request.resource.data.ownerId == resource.data.ownerId;
      }
      function removesOnlySelf() {
        let added = request.resource.data.members.toSet()
                      .difference(resource.data.members.toSet());
        let removed = resource.data.members.toSet()
                      .difference(request.resource.data.members.toSet());
        return removed.hasOnly([request.auth.uid])
            && removed.size() == 1
            && added.size() == 0
            && request.resource.data.ownerId == resource.data.ownerId;
      }

      // Член обновява безопасни полета (memberInfo/name) БЕЗ да пипа members/ownerId.
      function memberSafeUpdate() {
        return request.auth.uid in resource.data.members
            && request.resource.data.members.toSet().hasOnly(resource.data.members)
            && resource.data.members.toSet().hasOnly(request.resource.data.members)
            && request.resource.data.ownerId == resource.data.ownerId;
      }

      allow read: if isMember();

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && membersWithinLimit();

      allow delete: if isOwner();

      allow update: if (isOwner() && membersWithinLimit())
                    || (signedIn() && addsOnlySelf() && membersWithinLimit())
                    || (signedIn() && removesOnlySelf())
                    || (signedIn() && memberSafeUpdate());

      // Задачи в групата — read/write само за членове на родителската група.
      match /tasks/{taskId} {
        allow read, write: if signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }
  }
}
