<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_launcher"/>
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_add_btn" android:layout_width="22dp" android:layout_height="22dp"
            android:background="@drawable/widget_add_btn_bg" android:gravity="center" android:text="+"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:contentDescription="@string/widget_add_task"/>
    </LinearLayout>
    <!-- Локален контекст: изтичащ документ / имен ден / празник (скрит, ако няма) -->
    <TextView android:id="@+id/context_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:background="@drawable/widget_row_bg" android:padding="5dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="13sp"
        android:textStyle="bold" android:visibility="gone"/>
    <LinearLayout android:id="@+id/empty_container" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:visibility="gone">
        <TextView android:id="@+id/empty_text" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:maxLines="3" android:ellipsize="end" android:fontFamily="@font/caveat" android:textColor="#F2FFFFFF"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp"/>
        <!-- Локален контекст при празен списък: четим шрифт, не ръкописният -->
        <TextView android:id="@+id/empty_context" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:maxLines="3" android:ellipsize="end" android:textColor="#FFFFFF" android:textStyle="bold"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"
            android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/task_row_1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:padding="4dp">
            <ImageView android:id="@+id/task_checkbox_1" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/widget_checkbox"/>
            <TextView android:id="@+id/priority_dot_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="8sp" android:textColor="#EF5350" android:layout_marginStart="3dp" android:visibility="gone"/>
            <TextView android:id="@+id/task_title_1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/task_row_2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:padding="4dp" android:visibility="gone">
            <ImageView android:id="@+id/task_checkbox_2" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/widget_checkbox"/>
            <TextView android:id="@+id/priority_dot_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="8sp" android:textColor="#EF5350" android:layout_marginStart="3dp" android:visibility="gone"/>
            <TextView android:id="@+id/task_title_2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/task_row_3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:padding="4dp" android:visibility="gone">
            <ImageView android:id="@+id/task_checkbox_3" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/widget_checkbox"/>
            <TextView android:id="@+id/priority_dot_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="8sp" android:textColor="#EF5350" android:layout_marginStart="3dp" android:visibility="gone"/>
            <TextView android:id="@+id/task_title_3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/task_row_4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="2dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:padding="4dp" android:visibility="gone">
            <ImageView android:id="@+id/task_checkbox_4" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/widget_checkbox"/>
            <TextView android:id="@+id/priority_dot_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="8sp" android:textColor="#EF5350" android:layout_marginStart="3dp" android:visibility="gone"/>
            <TextView android:id="@+id/task_title_4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/task_row_5" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/widget_row_bg" android:gravity="center_vertical" android:padding="4dp" android:visibility="gone">
            <ImageView android:id="@+id/task_checkbox_5" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/widget_checkbox"/>
            <TextView android:id="@+id/priority_dot_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="8sp" android:textColor="#EF5350" android:layout_marginStart="3dp" android:visibility="gone"/>
            <TextView android:id="@+id/task_title_5" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
