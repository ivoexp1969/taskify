<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Gradient background - dark glass effect -->
    <gradient
        android:startColor="#E6121218"
        android:centerColor="#E6181820"
        android:endColor="#E6101018"
        android:angle="135"
        android:type="linear" />
    
    <!-- Rounded corners -->
    <corners android:radius="24dp" />
    
    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="#20FFFFFF" />

</shape>
